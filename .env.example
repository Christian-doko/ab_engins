# Variables d'environnement pour la production (Railway)
# En local XAMPP, aucune variable n'est nécessaire (valeurs par défaut).
DB_HOST=
DB_PORT=3306
DB_NAME=ab_engins
DB_USER=
DB_PASS=

# Assistant IA (api/agent.php) — clé API Anthropic (https://platform.claude.com)
# En local XAMPP : créer plutôt api/secrets.local.php qui contient :
#   <?php return 'sk-ant-...';
ANTHROPIC_API_KEY=
